{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"python.defaultInterpreterPath": "${workspaceFolder}/insight_venv/Scripts/python.exe",
		"python.linting.enabled": true,
		"python.linting.pylintEnabled": true,
		"python.formatting.provider": "black",
		"editor.formatOnSave": true,
		"files.exclude": {
			"**/__pycache__": true,
			"**/*.pyc": true
		},
		"[python]": {
			"editor.rulers": [
				88
			]
		},
		"terminal.integrated.env.windows": {
			"PYTHONPATH": "${workspaceFolder}"
		}
	},
	"extensions": {
		"recommendations": [
			"ms-python.python",
			"ms-python.vscode-pylance",
			"ms-toolsai.jupyter",
			"github.copilot",
			"github.copilot-chat",
			"ms-python.black-formatter",
			"ms-python.pylint"
		]
	},
	"launch": {
		"configurations": [
			{
				"name": "Run Streamlit App",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/insight_venv/Scripts/streamlit",
				"args": [
					"run",
					"${workspaceFolder}/app.py"
				],
				"console": "integratedTerminal",
				"justMyCode": true
			}
		]
	}
}
